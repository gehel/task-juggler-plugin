<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>fr.ledcom.tj3.task-juggler-plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>TaskJuggler</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="guillaume.lederrey@gmail.com" url="https://github.com/gehel/task-juggler-plugin">Guillaume Lederrey</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
Language support for <a href="https://taskjuggler.org/">TaskJuggler</a> project files (<code>.tjp</code>, <code>.tji</code>).
<ul>
  <li>Syntax and semantic highlighting of keywords, declarations, references, values, macros, dates and durations</li>
  <li>Context aware completion of keywords, attribute values and references to tasks, resources, accounts, shifts,
      scenarios, flags and macros; live templates</li>
  <li>Go to declaration, find usages and rename for tasks (including relative <code>!</code> ids), resources,
      accounts, shifts, scenarios, reports, flags, macros and user defined attributes, across included files</li>
  <li>Quick documentation from the TaskJuggler syntax reference</li>
  <li>Inspections for misplaced or unknown keywords, unresolved references, duplicate ids and deprecated keywords,
      plus the errors reported by <code>tj3 --check-syntax</code></li>
  <li>Structure view, folding, breadcrumbs, formatter, comments and brace matching</li>
  <li>Run configuration to schedule projects and generate reports with <code>tj3</code></li>
</ul>
]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.psi.TjFileType"
                fieldName="INSTANCE"
                language="TaskJuggler"
                extensions="tjp;tji"/>
        <lang.parserDefinition
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.TJParserDefinition"/>

        <!-- Highlighting -->
        <lang.syntaxHighlighterFactory
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.highlighting.TJSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.highlighting.TJColorSettingsPage"/>
        <annotator
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.highlighting.TJHighlightingAnnotator"/>

        <!-- Editor -->
        <lang.commenter
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJCommenter"/>
        <lang.braceMatcher
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJBraceMatcher"/>
        <lang.quoteHandler
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJQuoteHandler"/>
        <lang.foldingBuilder
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJFoldingBuilder"/>
        <lang.psiStructureViewFactory
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.structure.TJStructureViewFactory"/>
        <breadcrumbsInfoProvider
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJBreadcrumbsProvider"/>

        <!-- References and navigation -->
        <lang.elementManipulator
                forClass="fr.ledcom.tj3.taskjugglerplugin.language.psi.TJLiteral"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJLiteralManipulator"/>
        <lang.findUsagesProvider
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJFindUsagesProvider"/>
        <lang.namesValidator
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJNamesValidator"/>
        <lang.refactoringSupport
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJRefactoringSupportProvider"/>
        <gotoSymbolContributor
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.references.TJGotoSymbolContributor"/>

        <!-- Inspections -->
        <annotator
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.inspections.TJSyntaxAnnotator"/>
        <localInspection language="TaskJuggler" groupName="TaskJuggler" enabledByDefault="true" level="ERROR"
                         shortName="TJInvalidKeyword" displayName="Invalid or misplaced keyword"
                         implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.inspections.TJInvalidKeywordInspection"/>
        <localInspection language="TaskJuggler" groupName="TaskJuggler" enabledByDefault="true" level="ERROR"
                         shortName="TJUnresolvedReference" displayName="Unresolved reference"
                         implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.inspections.TJUnresolvedReferenceInspection"/>
        <localInspection language="TaskJuggler" groupName="TaskJuggler" enabledByDefault="true" level="ERROR"
                         shortName="TJDuplicateDeclaration" displayName="Duplicate declaration"
                         implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.inspections.TJDuplicateDeclarationInspection"/>
        <localInspection language="TaskJuggler" groupName="TaskJuggler" enabledByDefault="true" level="WARNING"
                         shortName="TJDeprecatedKeyword" displayName="Deprecated keyword"
                         implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.inspections.TJDeprecatedKeywordInspection"/>

        <externalAnnotator
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.tj3.TJ3ExternalAnnotator"/>

        <!-- TaskJuggler command line integration -->
        <applicationConfigurable
                parentId="language"
                instance="fr.ledcom.tj3.taskjugglerplugin.tj3.TJSettingsConfigurable"
                id="fr.ledcom.tj3.settings"
                displayName="TaskJuggler"/>

        <configurationType implementation="fr.ledcom.tj3.taskjugglerplugin.tj3.run.TJ3RunConfigurationType"/>
        <runConfigurationProducer implementation="fr.ledcom.tj3.taskjugglerplugin.tj3.run.TJ3RunConfigurationProducer"/>
        <internalFileTemplate name="TaskJuggler Project"/>
        <internalFileTemplate name="TaskJuggler Include File"/>

        <!-- Documentation -->
        <lang.documentationProvider
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.documentation.TJDocumentationProvider"/>

        <!-- Formatting -->
        <lang.formatter
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.formatter.TJFormattingModelBuilder"/>
        <codeStyleSettingsProvider
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.formatter.TJCodeStyleSettingsProvider"/>
        <langCodeStyleSettingsProvider
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.formatter.TJLanguageCodeStyleSettingsProvider"/>

        <!-- Completion -->
        <completion.contributor
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.completion.TJCompletionContributor"/>
        <liveTemplateContext
                contextId="TaskJuggler"
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.completion.TJTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/TaskJuggler.xml"/>
    </extensions>

    <actions>
        <action id="TaskJuggler.NewFile" class="fr.ledcom.tj3.taskjugglerplugin.tj3.run.TJCreateFileAction">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFromTemplate"/>
        </action>
    </actions>
</idea-plugin>
