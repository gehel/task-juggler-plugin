<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>fr.ledcom.tj3.task-juggler-plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Task Juggler</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://ledcom.fr">LedCom</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description>IntelliJ plugin to support Task Juggler files.</description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.psi.TjFileType"
                fieldName="INSTANCE"
                language="TaskJuggler"
                extensions="tjp;tji"/>
        <lang.parserDefinition
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.TJParserDefinition"/>

        <!-- Highlighting -->
        <lang.syntaxHighlighterFactory
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.highlighting.TJSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.highlighting.TJColorSettingsPage"/>
        <annotator
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.highlighting.TJHighlightingAnnotator"/>

        <!-- Editor -->
        <lang.commenter
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJCommenter"/>
        <lang.braceMatcher
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJBraceMatcher"/>
        <lang.quoteHandler
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJQuoteHandler"/>
        <lang.foldingBuilder
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJFoldingBuilder"/>
        <lang.psiStructureViewFactory
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.structure.TJStructureViewFactory"/>
        <breadcrumbsInfoProvider
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.editor.TJBreadcrumbsProvider"/>

        <!-- References and navigation -->
        <lang.elementManipulator
                forClass="fr.ledcom.tj3.taskjugglerplugin.language.psi.TJLiteral"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJLiteralManipulator"/>
        <lang.findUsagesProvider
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJFindUsagesProvider"/>
        <lang.namesValidator
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJNamesValidator"/>
        <lang.refactoringSupport
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.references.TJRefactoringSupportProvider"/>
        <gotoSymbolContributor
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.references.TJGotoSymbolContributor"/>

        <!-- Formatting -->
        <lang.formatter
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.formatter.TJFormattingModelBuilder"/>
        <codeStyleSettingsProvider
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.formatter.TJCodeStyleSettingsProvider"/>
        <langCodeStyleSettingsProvider
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.formatter.TJLanguageCodeStyleSettingsProvider"/>

        <!-- Completion -->
        <completion.contributor
                language="TaskJuggler"
                implementationClass="fr.ledcom.tj3.taskjugglerplugin.language.completion.TJCompletionContributor"/>
        <liveTemplateContext
                contextId="TaskJuggler"
                implementation="fr.ledcom.tj3.taskjugglerplugin.language.completion.TJTemplateContextType"/>
        <defaultLiveTemplates file="/liveTemplates/TaskJuggler.xml"/>
    </extensions>
</idea-plugin>
